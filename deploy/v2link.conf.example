# v2link nginx 配置示例（部署模板）
# 复制到 /etc/nginx/conf.d/v2link.conf 并把所有 <YOUR_DOMAIN> / <AUTH_SERVER> 换成实际值后：
#   nginx -t && systemctl reload nginx
#
#   - /v2ws : VLESS WebSocket 入口 → xray 127.0.0.1:7895
#   - /api/ : SSO 探针鉴权 → v2link 控制面 127.0.0.1:7897
#   - /     : 前端静态（控制面托管）

server {
    server_name <YOUR_DOMAIN>;

    # ---- VLESS over WebSocket（客户端流量入口）----
    location /v2ws {
        proxy_pass http://127.0.0.1:7895;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- 控制面 API（SSO 探针保护）----
    location /api/ {
        set $auth_token $arg_token;
        auth_request /auth-check;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        proxy_pass http://127.0.0.1:7897;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Auth-User $auth_user;
    }

    # ---- SSO 鉴权探针（内部，指向你的认证中心）----
    location = /auth-check {
        internal;
        proxy_method GET;
        proxy_pass http://127.0.0.1:<AUTH_SERVER_PORT>/api/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Content-Type "";
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Auth-Token $auth_token;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # ---- 前端 + SPA 回退 ----
    location / {
        proxy_pass http://127.0.0.1:7897;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# HTTP → HTTPS 跳转
server {
    server_name <YOUR_DOMAIN>;
    listen 80;
    return 301 https://$host$request_uri;
}
