# v2link nginx 配置示例（部署模板）
# 复制到 /etc/nginx/conf.d/v2link.conf 并把 <YOUR_DOMAIN> 换成实际值后：
#   nginx -t && systemctl reload nginx
#
#   - /v2ws : VLESS WebSocket 入口 → xray 127.0.0.1:7895（公开，不需要登录）
#   - /_auth/ : Auth Gateway 专用前缀（登录/回调/登出/me），必须排在其它 location 之前
#   - /api/ : 交给 Auth Gateway（127.0.0.1:18920）鉴权，网关再反代到控制面并注入 X-Auth-User
#   - /     : 前端静态（公开，控制面托管）
# 这里不再有任何 auth_request / auth-check / ?token= 鉴权逻辑。

server {
    server_name <YOUR_DOMAIN>;

    # ---- VLESS over WebSocket（客户端流量入口）----
    location /v2ws {
        proxy_pass http://127.0.0.1:7895;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # ---- Auth Gateway（登录/回调/登出/me）：必须排在其他 location 之前 ----
    location /_auth/ {
        proxy_pass http://127.0.0.1:18920;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 控制面 API：全部交给网关，鉴权通过后由网关反代并注入 X-Auth-User ----
    # Clash 订阅抓取：**必须公开**（token 即凭据，Clash 抓取时不带 cookie）
    # 红线：这里不得经过认证网关，否则扫码/导入时会被 SSO 拦成 302
    # ^~ 前缀优先于下面的 location /api/，故必须排在它之前
    location ^~ /api/clash/subscriptions/ {
        proxy_pass http://127.0.0.1:7897;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:18920;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- 前端 + SPA 回退（公开）----
    location / {
        proxy_pass http://127.0.0.1:7897;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# HTTP → HTTPS 跳转
server {
    server_name <YOUR_DOMAIN>;
    listen 80;
    return 301 https://$host$request_uri;
}
