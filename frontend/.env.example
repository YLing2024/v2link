# Copy to frontend/.env and fill real values. Never commit real .env.

# SSO 认证中心地址（用户可见，如 https://auth.example.com/auth）
# 构建时注入；未登录/401 跳转的目标
VITE_AUTH_CENTER_URL=https://auth.example.com/auth

# Vite dev server 把 /api 代理到的后端地址（本机同服默认即可）
# 生产不用此变量（nginx 反代）
VITE_API_PROXY_TARGET=http://127.0.0.1:7897

# 公开链接主机/路径（生成 vless:// 用；仅影响复制/二维码展示）
# 生产与部署域名一致
VITE_PUBLIC_HOST=v2.example.com
VITE_PUBLIC_PATH=/v2ws
