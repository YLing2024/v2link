# v2link server 环境变量示例（复制为 server/.env；真实值绝不入库，源码零硬编码）
# 部署见根 README「部署」一节；本仓库只提交占位值。

# ---- 服务 ----
# 控制面 HTTP 监听端口（nginx 反代目标；本地直连调试用）
PORT=7897
# 绑定地址。生产保持 127.0.0.1（由 nginx 交给 Auth Gateway 127.0.0.1:18920 鉴权后反代进来）。
HOST=127.0.0.1

# ---- 数据面（xray api 管理接口）----
# xray api 监听地址（xray 侧 config.json 的 api.listen）
XRAY_API=127.0.0.1:8081
# xray api CLI 可执行文件路径
XRAY_BIN=xray
# 受管 inbound 的 tag（adu/rmu 均按此 tag 操作）
XRAY_INBOUND_TAG=vless-in
# 单次 xray api 调用超时（秒，默认 3）
XRAY_API_TIMEOUT_S=3
# 调用失败重试次数（默认 2，配合退避）
XRAY_API_RETRIES=2

# ---- 链接生成默认/上限 ----
# 默认时长（小时）与允许的最大时长（小时）
DEFAULT_HOURS=24
MAX_HOURS=720

# ---- 定时器 ----
# 过期扫描周期（秒，默认 15）与流量账本累计周期（秒，默认 30）
EXPIRE_SCAN_INTERVAL_S=15
LEDGER_INTERVAL_S=30

# ---- 监控/追溯/审计（TASK-monitoring.md A/B/C）----
# xray access log 文件（deploy/xray.config.json 的 log.access；logrotate 轮转见 deploy/xray-logrotate）
ACCESS_LOG_PATH=/var/log/xray/access.log
# connections（连接追溯）保留：小时级清理，默认保留 7 天
CONN_CLEANUP_INTERVAL_S=3600
CONN_RETENTION_S=604800
# traffic_samples（流量曲线采样）保留：默认保留 30 天
SAMPLE_CLEANUP_INTERVAL_S=86400
SAMPLE_RETENTION_S=2592000

# ---- 地区连通性探测（底部状态条）----
# 每 5 分钟服务器直连各主流地区 HTTPS 端点测延迟（HTTP 探测，非 ICMP）。
# 端点列表默认内置（US gstatic / EU bbc.com / JP yahoo.co.jp / SG cloudflare.com）；
# 如需自定义，用 JSON 覆盖：REGION_PROBES=[{"key":"us","name":"美国","flag":"🇺🇸","url":"https://…/generate_204"}]
# （留空即用内置；格式非法自动回落内置）
# REGION_PROBES=
# 探测周期（秒，默认 300；最小 60）
REGION_PROBE_INTERVAL_S=300

# ---- 鉴权 ----
# 登录与 SSO 全部由 Auth Gateway（127.0.0.1:18920，nginx 反代进来）负责。
# 本服务只从网关注入的 X-Auth-User 头读用户，头缺失返回 401；不再有任何 token / 探针配置。

# ---- SQLite 数据文件 ----
# 默认 server/data/v2link.db（data/ 已 gitignore）。生产可指向持久卷。
# DB_PATH=./data/v2link.db
